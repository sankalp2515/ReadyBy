# Copy to .env or set values in your shell. Node loads .env at startup;
# existing shell values take precedence. Never commit the real .env.
# Local mode needs an installed Ollama model. No hosted key is required.
READYBY_AI_PROVIDER=ollama
READYBY_OLLAMA_URL=http://127.0.0.1:11434
READYBY_MODEL=llama3:8b-instruct-q4_K_M
# For hosted inference, change provider to groq (or gemini/nvidia).
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
READYBY_GROQ_MODEL=openai/gpt-oss-120b
READYBY_GEMINI_MODEL=gemini-3.1-flash-lite
READYBY_NVIDIA_MODEL=openai/gpt-oss-20b
# Only used in hosted mode; configured fallbacks are reported in receipts.
READYBY_AI_FALLBACKS=gemini
READYBY_DATABASE=data/readyby-platform.sqlite
PORT=4173
# Optional local speech; defaults are created by python scripts/setup-speech.py.
# READYBY_SPEECH_PYTHON=absolute/path/to/.venv-speech/Scripts/python.exe
# READYBY_SPEECH_MODEL=absolute/path/to/data/speech/vosk-model-small-en-us-0.15
# Public deployment configuration requires separate verification:
# NODE_ENV=production
# READYBY_ORIGIN=https://your-verified-host.example
