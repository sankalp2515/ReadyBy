{
  "name": "readyby",
  "version": "0.4.0",
  "description": "A deadline-aware household assistant with checked recovery, explicit review and a real MCP server for an Alexa+ web simulator.",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sankalp2515/ReadyBy.git"
  },
  "bugs": {
    "url": "https://github.com/sankalp2515/ReadyBy/issues"
  },
  "homepage": "https://34-10-147-168.sslip.io/",
  "keywords": [
    "alexa-plus",
    "mcp",
    "household",
    "scheduling",
    "ai-agents"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node app-server.mjs",
    "test": "node --test",
    "evaluate": "node scripts/evaluate.mjs",
    "evaluate:ai": "node scripts/evaluate-ai.mjs",
    "legacy": "node server.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "prototype": "node readyby-server.mjs",
    "demo:mcp": "node scripts/mcp-demo.mjs",
    "demo:mcp:live": "node scripts/mcp-demo.mjs --live",
    "evaluate:providers": "node scripts/benchmark-providers.mjs groq --full --fallback"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
